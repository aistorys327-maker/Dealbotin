# ====================================================================
# Indian Deals Bot & Admin Dashboard - Environment Configuration
# ====================================================================
# IMPORTANT: Never commit your real secrets to Git or expose them in the frontend!
# On Netlify: Set these in Site Configuration > Environment Variables.
# Locally: Copy this file to .env and fill in your values.

# --------------------------------------------------------------------
# 1. Dashboard Admin Authentication (Required)
# --------------------------------------------------------------------
# Password used to log in to the mobile admin dashboard and protect API routes.
ADMIN_PASSWORD=""

# --------------------------------------------------------------------
# 2. Telegram Bot Configuration (Required for Telegram alerts)
# --------------------------------------------------------------------
# Obtain from @BotFather on Telegram (e.g., 1234567890:ABCdefGhIJKlmNoPQRstuvWXyz)
TELEGRAM_BOT_TOKEN=""
# Channel ID or username (e.g., @mydealschannel or -1001234567890)
# Remember to make your bot an Admin in your channel with post permissions!
TELEGRAM_CHANNEL_ID=""

# --------------------------------------------------------------------
# 3. Amazon India Associates / PA-API 5.0 (Optional / Recommended)
# --------------------------------------------------------------------
# Marketplace: www.amazon.in | Region: eu-west-1 (PA-API 5.0)
# Create in Amazon Associates Portal -> Tools -> Product Advertising API
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_PARTNER_TAG=""

# --------------------------------------------------------------------
# 4. Flipkart Affiliate API (Optional / Recommended - covers Shopsy)
# --------------------------------------------------------------------
# From Flipkart Affiliate Portal -> API Access
FLIPKART_AFFILIATE_ID=""
FLIPKART_AFFILIATE_TOKEN=""

# --------------------------------------------------------------------
# 5. Google Gemini AI (Optional - for Hinglish viral deal captions)
# --------------------------------------------------------------------
# Get a free API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=""

# --------------------------------------------------------------------
# 6. Facebook Page Integration (Optional - for auto-posting to FB)
# --------------------------------------------------------------------
# Page ID and Page Access Token with pages_manage_posts & pages_read_engagement
FB_PAGE_ID=""
FB_PAGE_TOKEN=""
